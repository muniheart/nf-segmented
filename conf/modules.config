import java.lang.Math;

def make_workdir_path( index, base, depth ) {
    p = []
    while ( p.size()<depth ) {
        p.add( sprintf("0o%o",index % base ) )
        index = index.intdiv( base )
    }
    if ( index>0 )
        p.add( "$index" )
    log.info "make_workdir_path: p: $p"
    p.reverse().join("/")
}

env.APPTAINER_MESSAGELEVEL=5
env.SINGULARITY_MESSAGELEVEL=5

process {
    withName: SQUASH_WORK {
        publishDir = [
            [
                path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
                pattern: '*.sqfs',
                mode: 'symlink',
                overwrite: true,
            ]
        ]
    }

    withName: NFCORE_DEMO {
        //  Add path component './decouple_hash/' so removal of workdir files won't invalidate task cache.
        ext.relpath = { make_workdir_path( task.index, params.base, params.depth ) }
        ext.workdir = {
            [
                workflow.workDir,
                task.process.tokenize(':')[-1].toLowerCase(),
                task.ext.relpath,
                "decouple_hash"
            ].join('/')
        }

        containerOptions = {
            [
                container_opts,
                "--env NXF_CACHE_DIR=/nextflow",
                "-B ${cache_dir}:/nextflow",
            ].join(' ')
        }
    }
    withName: GET_INPUTS_FROM_DATA_FINAL {
        ext.is_final = true
    }
    withName: GET_INPUTS_FROM_DATA {
        ext.is_final = false
    }
    withName: MERGE_IMAGES {
        container = "https://depot.galaxyproject.org/singularity/nextflow%3A25.04.6--h2a3209d_0"

        containerOptions = { container_opts }

        publishDir = [
            [
                path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}/run_${params.run_count}" },
                pattern: 'work.sqfs',
                mode: 'symlink',
                overwrite: true,
            ]
        ]
    }
}
